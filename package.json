{
  "name": "vaultcrdt-plugin",
  "version": "0.5.1",
  "description": "Obsidian plugin for VaultCRDT sync",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "bun esbuild.config.mjs",
    "dev": "bun esbuild.config.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:watch": "vitest",
    "wasm": "./scripts/build-wasm.sh",
    "wasm:check": "./scripts/check-wasm-fresh.sh"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
